// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  telegramId String  @unique
  username     String?
  firstName    String?
  lastName     String?
  groupChatId  String?
  role         String   @default("USER")
  licenseExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  links         Link[]
  notifications Notification[]
  settings      Setting?
  usedLicenseKeys LicenseKey[]
}

model Link {
  id           Int      @id @default(autoincrement())
  userId       Int
  platform     String
  url          String
  name         String?
  photoUrl     String?
  username     String?
  followerCount String?
  currentStatus String   @default("UNKNOWN")
  lastStatus   String?
  lastChecked  DateTime?
  lastChanged  DateTime?
  isArchived   Boolean  @default(false)
  isMuted      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories    History[]

  @@unique([userId, url])
}

model History {
  id        Int      @id @default(autoincrement())
  linkId    Int
  status    String
  checkedAt DateTime @default(now())

  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  sentAt    DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  notifyOnChange Boolean  @default(true)
  checkInterval  Int      @default(10) // minutes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LicenseKey {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  durationDays Int
  isUsed       Boolean  @default(false)
  usedByUserId Int?
  createdAt    DateTime @default(now())
  usedAt       DateTime?

  usedByUser   User?    @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)
}

model SupportContact {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  createdAt DateTime @default(now())
}
